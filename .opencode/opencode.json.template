{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "theme": "tokyonight",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "__HOME__/repositories"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "fetch": {
      "type": "local",
      "command": ["__HOME__/.venvs/mcp-fetch/bin/python", "-m", "mcp_server_fetch"]
    },
    "git": {
      "type": "local",
      "command": ["npx", "@cyanheads/git-mcp-server@latest"]
    }
  }
}
